        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コネクタが現在の設定を受け付けませんでした。連絡先、通話モード、サービスのバージョンを確認してから再度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {

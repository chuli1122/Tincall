        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートの端末連携を自動で解除できませんでした。サーバー側で別途解除できます。この端末の接続の削除には影響しません。"
          }
        },
        "ko" : {

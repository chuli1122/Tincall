      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Restore Connection on the call screen for interrupted external calls. After the app closes, restore an unfinished call from its record. Recovery fetches missed events without replaying existing audio. A call ended remotely cannot be restored as a new call."

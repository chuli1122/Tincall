{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "仍有内容未保存：%lld 段录音、%lld 条文字。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still not saved: %1$lld recording clips and %2$lld text inputs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ保存されていない内容があります：録音 %lld 件、テキスト %lld 件。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 저장되지 않은 항목이 있습니다: 녹음 %lld개, 텍스트 %lld개."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍有內容未儲存：%lld 段錄音、%lld 則文字。"
          }
        }
      }
    },
    "也可左右滑动通话内容切换" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can also swipe left or right on the call content"

    "迁移：授权注册与推送清理" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migration: authorization registration and push cleanup"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

          "stringUnit" : {
            "state" : "translated",
            "value" : "移行：MCP 通話と許可の保護"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이그레이션: MCP 통화 및 권한 보호"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

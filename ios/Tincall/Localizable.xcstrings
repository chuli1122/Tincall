    },
    "后台来电" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background Calls"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンド着信"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 수신"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景來電"
          }
        }
      }
    },
    "后台来电：App Store 版使用由作者维护的推送发送端。设备推送标识和必要的来电路由信息会在你配置的云端与该发送端之间传输，用于向这台 iPhone 发起来电；来电推送不携带聊天正文或录音。自行签名或自部署的版本需要使用自己的匹配推送服务。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background calls: The App Store version uses a push sender maintained by the author. The device push identifier and necessary call-routing data are sent between your configured cloud service and that sender to call this iPhone. Incoming call notifications contain no conversation text or recordings. Self-signed or self-deployed versions need their own matching push service."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンド着信：App Store 版では作者が運用するプッシュ送信サービスを使用します。この iPhone に着信をかけるため、端末のプッシュ識別子と必要な着信ルーティング情報が、あなたが設定したクラウドとその送信サービスの間でやり取りされます。着信のプッシュには会話の本文や録音は含まれません。自分で署名・デプロイした版では、それに合った自分のプッシュサービスを使う必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 수신: App Store 버전은 개발자가 운영하는 푸시 발신 서비스를 사용합니다. 이 iPhone으로 전화를 걸기 위해 기기 푸시 식별자와 필요한 수신 라우팅 정보가 사용자가 설정한 클라우드와 해당 발신 서비스 사이에서 전송됩니다. 수신 푸시에는 대화 본문이나 녹음이 포함되지 않습니다. 직접 서명하거나 직접 배포한 버전은 그에 맞는 자체 푸시 서비스를 사용해야 합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景來電：App Store 版使用由作者維護的推播傳送端。裝置推播識別碼和必要的來電路由資訊會在你設定的雲端與該傳送端之間傳輸，用於向這支 iPhone 發起來電；來電推播不含聊天內文或錄音。自行簽署或自行部署的版本需要使用自己對應的推播服務。"
          }
        }
      }
    },
    "后台通话卡片尚未完成推送绑定，请更新云端服务" : {

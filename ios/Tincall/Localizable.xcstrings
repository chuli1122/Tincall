        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話画面を左右にスワイプしても切り替えられます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화 화면을 좌우로 쓸어 넘겨 전환할 수도 있습니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可左右滑動通話內容切換"

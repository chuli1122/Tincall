          }
        }
      }
    },
    "麦克风用于通话收音和识别测试。关联系统联系人时使用你授权的联系人资料；设置头像、背景或发送图片时，由你选择要使用的图片。这些可选操作无需在首次打开 App 时全部授权。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone is used for calls and recognition tests. Linking a system contact uses only the contact information you allow. You choose the images used for photos, backgrounds, and messages. These optional permissions are not all required when you first open the app."
          }
        }
      }
    },
    "麦克风音频为空" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone audio is empty"
